# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).

# --- Flask chatbot app (python -m database.server)
MYSQL_HOST=127.0.0.1
MYSQL_USER=gadyen_app          # a dedicated MySQL user with rights on `compsec` only, not root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=compsec
# At least 32 random chars. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
GEMINI_API_KEY=
# Optional
GADYEN_CHAT_MODEL=gemini-3.5-flash-lite
GADYEN_MEMORY_FILE=            # default: ~/.gadyen/user_memory.json (outside the web root)
SESSION_COOKIE_SECURE=0        # set to 1 when served over HTTPS
FLASK_DEBUG=0                  # never 1 on a reachable host: the debugger allows code execution
HOST=127.0.0.1
PORT=3000

# --- Scanner API (uvicorn gadyen.api:app)
ANTHROPIC_API_KEY=
GADYEN_DEV_KEY=
GADYEN_DB_PATH=gadyen.db
